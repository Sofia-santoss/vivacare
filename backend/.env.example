# Copie este arquivo para ".env" e preencha com os dados do SEU computador.
# O arquivo ".env" nunca deve ser enviado ao GitHub.

NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vivacare
DB_USER=troque_pelo_usuario
DB_PASSWORD=troque_pela_senha
# Obrigatorias para POST de respostas (usar valores aprovados antes de habilitar)
AUTH_LOGIN_THROTTLE_SECRET=preencher_com_segredo_aleatorio_de_32_bytes
PUBLIC_SURVEY_FINGERPRINT_SECRET=preencher_com_segredo_aleatorio_de_32_bytes
PUBLIC_SURVEY_IP_LIMIT=preencher_com_limite_aprovado
PUBLIC_SURVEY_IP_WINDOW_SECONDS=preencher_com_janela_aprovada
