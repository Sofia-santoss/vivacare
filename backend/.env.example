# Copie este arquivo para ".env" e preencha com os dados do SEU computador.
# O arquivo ".env" nunca deve ser enviado ao GitHub.
# NODE_ENV é obrigatório; valores aceitos: development, test ou production.
# A aplicação encerra a inicialização se estiver ausente ou tiver outro valor.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vivacare
DB_USER=troque_pelo_usuario
DB_PASSWORD=troque_pela_senha

# Origem exata do frontend, separada por vírgula quando houver mais de uma.
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_CSRF_SECRET=gere_um_segredo_aleatorio_com_pelo_menos_32_bytes
# Caminho da tela de primeiro acesso incluído nos convites (o adaptador de e-mail ainda precisa ser conectado).
USER_INVITE_URL_BASE=http://localhost:5173/primeiro-acesso

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Configure the secret in a secret manager; share the same value across backend instances.
# Configure both IP limit variables only after the deployment limits are approved.
# TRUSTED_PROXY_IPS accepts exact IPs of proxies that safely set X-Forwarded-For.
# AUTH_LOGIN_THROTTLE_SECRET=
# Stable server secret for HMAC of normalized public survey payloads. Keep it stable while idempotency records are retained.
# PUBLIC_SURVEY_FINGERPRINT_SECRET=
# AUTH_LOGIN_IP_LIMIT=
# AUTH_LOGIN_IP_WINDOW_SECONDS=
# The public survey endpoint has its own IP rate limit, independent of login and survey code.
# Production startup requires both values. Select approved values for expected traffic.
# PUBLIC_SURVEY_IP_LIMIT=
# PUBLIC_SURVEY_IP_WINDOW_SECONDS=
# TRUSTED_PROXY_IPS=

# Sector authorization codes are defined in backend/src/auth/permissions.ts.
# Provision them through migration 004_matriz_autorizacao; do not override via environment.
