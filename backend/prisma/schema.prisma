generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  OMBUDSMAN
  VIEWER
}

enum SurveyStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AnswerType {
  FACES
  SCALE
  OPTIONS
  MULTI_OPTIONS
  NPS
  TEXT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketType {
  COMPLAINT
  PRAISE
  SUGGESTION
  OTHER
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  passwordHash String
  role Role
  active Boolean @default(true)
  sectors UserSector[]
  assignedTickets Ticket[] @relation("TicketAssignee")
  contactAttempts ContactAttempt[]
  ticketHistory TicketHistory[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sector {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  description String?
  active Boolean @default(true)
  questions Question[]
  teams Team[]
  sessions SurveySession[]
  tickets Ticket[]
  users UserSector[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSector {
  userId String @db.Uuid
  sectorId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  @@id([userId, sectorId])
}

model Team {
  id String @id @default(uuid()) @db.Uuid
  name String
  sectorId String @db.Uuid
  sector Sector @relation(fields: [sectorId], references: [id])
  sessions SurveySession[]
  createdAt DateTime @default(now())
  @@unique([sectorId, name])
}

model Survey {
  id String @id @default(uuid()) @db.Uuid
  name String
  active Boolean @default(true)
  version Int @default(1)
  questions Question[]
  sessions SurveySession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id String @id @default(uuid()) @db.Uuid
  surveyId String @db.Uuid
  sectorId String? @db.Uuid
  text String
  type AnswerType
  order Int
  required Boolean @default(false)
  active Boolean @default(true)
  skippable Boolean @default(true)
  countsForSatisfaction Boolean @default(false)
  options Json?
  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sector Sector? @relation(fields: [sectorId], references: [id])
  answers Answer[]
  rules ConditionalRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([surveyId, order])
}

model SurveySession {
  id String @id @default(uuid()) @db.Uuid
  resumeTokenHash String @unique
  surveyId String @db.Uuid
  sectorId String @db.Uuid
  teamId String? @db.Uuid
  status SurveyStatus @default(IN_PROGRESS)
  configSnapshot Json
  startedAt DateTime @default(now())
  lastActivityAt DateTime @default(now())
  completedAt DateTime?
  survey Survey @relation(fields: [surveyId], references: [id])
  sector Sector @relation(fields: [sectorId], references: [id])
  team Team? @relation(fields: [teamId], references: [id])
  answers Answer[]
  ticket Ticket?
  consent Consent?
  @@index([status, startedAt])
  @@index([sectorId, completedAt])
}

model Answer {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  questionId String @db.Uuid
  sectorId String? @db.Uuid
  value Json
  answeredAt DateTime @default(now())
  session SurveySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  @@unique([sessionId, questionId])
  @@index([questionId, answeredAt])
}

model ConditionalRule {
  id String @id @default(uuid()) @db.Uuid
  questionId String @db.Uuid
  operator String @default("LT")
  threshold Float
  enabled Boolean @default(true)
  message String
  question Question @relation(fields: [questionId], references: [id])
  createdAt DateTime @default(now())
}

model Consent {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @unique @db.Uuid
  purpose String
  noticeVersion String
  granted Boolean
  recordedAt DateTime @default(now())
  session SurveySession @relation(fields: [sessionId], references: [id])
}

model Ticket {
  id String @id @default(uuid()) @db.Uuid
  protocol String @unique
  sessionId String @unique @db.Uuid
  sectorId String @db.Uuid
  phone String?
  statement String?
  type TicketType @default(OTHER)
  status TicketStatus @default(OPEN)
  assignedToId String? @db.Uuid
  outcome String?
  openedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session SurveySession @relation(fields: [sessionId], references: [id])
  sector Sector @relation(fields: [sectorId], references: [id])
  assignedTo User? @relation("TicketAssignee", fields: [assignedToId], references: [id])
  contactAttempts ContactAttempt[]
  history TicketHistory[]
  @@index([status, openedAt])
  @@index([sectorId, openedAt])
}

model ContactAttempt {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  userId String @db.Uuid
  result String
  attemptedAt DateTime @default(now())
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model TicketHistory {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  userId String? @db.Uuid
  action String
  details String?
  createdAt DateTime @default(now())
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
  @@index([ticketId, createdAt])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  action String
  entity String
  entityId String?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@index([entity, entityId, createdAt])
}
